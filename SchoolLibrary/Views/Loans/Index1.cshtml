@model List<SchoolLibrary.Data.Entities.Loan>

<h2>Active Loans</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">+ New Loan</a>
    <a asp-action="History" class="btn btn-outline-secondary">History</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Book</th>
            <th>Loan Date</th>
            <th>Return</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.Student?.FullName (@l.Student?.Grade)</td>
                <td>@l.Book?.Title - @l.Book?.Author?.Name</td>
                <td>@l.LoanDate</td>
                <td>
                    <form asp-action="Return" method="post">
                        <input type="hidden" name="id" value="@l.Id" />
                        <button type="submit" class="btn btn-sm btn-success">Return</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
