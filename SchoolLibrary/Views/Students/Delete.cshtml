@model SchoolLibrary.Data.Entities.Student

<h2>Изтриване на ученик</h2>

<div class="alert alert-warning">
    Сигурни ли сте, че искате да изтриете този ученик?
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Име:</strong> @Model.FullName</p>
        <p><strong>Клас:</strong> @Model.Grade</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
