@model SchoolLibrary.Models.Home.HomeDashboardViewModel

<div class="py-4">
    <div class="p-4 p-md-5 mb-4 bg-light rounded-3 border">
        <h1 class="display-6 fw-bold">SchoolLibrary</h1>
        <p class="lead mb-0">
            Управление на книги, автори, ученици и заеми (EF Core Database First).
        </p>
        <div class="mt-3 d-flex gap-2 flex-wrap">
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary">Книги</a>
            <a asp-controller="Authors" asp-action="Index" class="btn btn-outline-primary">Автори</a>
            <a asp-controller="Students" asp-action="Index" class="btn btn-outline-primary">Ученици</a>
            <a asp-controller="Loans" asp-action="Index" class="btn btn-success">Активни заеми</a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Книги</div>
                    <div class="fs-2 fw-semibold">@Model.BooksCount</div>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Books" asp-action="Index">Виж всички</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Автори</div>
                    <div class="fs-2 fw-semibold">@Model.AuthorsCount</div>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Authors" asp-action="Index">Виж всички</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Ученици</div>
                    <div class="fs-2 fw-semibold">@Model.StudentsCount</div>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Students" asp-action="Index">Виж всички</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body">
                    <div class="text-muted">Активни заеми</div>
                    <div class="fs-2 fw-semibold">@Model.ActiveLoansCount</div>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-controller="Loans" asp-action="Index">Към заемите</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="d-flex align-items-center justify-content-between">
            <h3 class="h5 mb-0">Последни активни заеми</h3>
            <a asp-controller="Loans" asp-action="Create" class="btn btn-sm btn-success">+ Нов заем</a>
        </div>

        <div class="card mt-2 shadow-sm">
            <div class="card-body p-0">
                @if (Model.LastActiveLoans.Count == 0)
                {
                    <div class="p-3 text-muted">Няма активни заеми.</div>
                }
                else
                {
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Ученик</th>
                                <th>Книга</th>
                                <th>Дата</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.LastActiveLoans)
                            {
                                <tr>
                                    <td>@l.Student.FullName (@l.Student.Grade)</td>
                                    <td>@l.Book.Title - @l.Book.Author.Name</td>
                                    <td>@l.LoanDate</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>
