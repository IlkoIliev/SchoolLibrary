@model List<SchoolLibrary.Data.Entities.Loan>

<h2>Active Loans</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<p class="mb-3">
    <a asp-action="Create" class="btn btn-primary">+ New Loan</a>
    <a asp-action="History" class="btn btn-outline-secondary">History</a>
</p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Student</th>
            <th>Book</th>
            <th>Loan Date</th>
            <th style="width: 140px;">Status</th>
            <th style="width: 140px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted">Няма активни заеми.</td>
            </tr>
        }
        else
        {
            foreach (var l in Model)
            {
                <tr>
                    <td>
                        @(l.Student != null
                                        ? $"{l.Student.FullName} ({l.Student.Grade})"
                                        : "-")
            </td>

                    <td>
                @if (l.Book != null)
                        {
                            <span>@l.Book.Title</span>
                            <span class="text-muted"> - @l.Book.Author?.Name</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>
                        @l.LoanDate.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        <span class="badge bg-success">Active</span>
                    </td>

                    <td>
                        <form asp-action="Return"
                              asp-route-id="@l.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Сигурен ли си, че книгата се връща?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">
                                Return
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>